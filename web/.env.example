# Copy to web/.env.local. Every variable is optional for unit tests and the
# Playwright smoke run: without Supabase settings, auth is off and the (app)
# screens render without a session.

# FastAPI base URL (openapi-fetch client).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project (Settings > API). The anon (publishable) key is public by design.
# Add http://localhost:3000/auth/callback to Auth > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated flags: calculators=<id>+<id>, sankey, e2e. See CLAUDE.md.
NEXT_PUBLIC_FEATURES=calculators=401k_match

# The demo/e2e account: when the signed-in email matches, the header shows a
# "Sample data" chip. pnpm e2e sets it from E2E_USER_EMAIL when unset.
NEXT_PUBLIC_E2E_USER_EMAIL=

# Playwright only (never read by the app): a confirmed user in the Supabase
# project above, holding synthetic data only. Unset skips the signed-in e2e tests.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
