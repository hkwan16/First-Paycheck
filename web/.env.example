# Copy to web/.env.local. Every variable is optional for unit tests and the
# Playwright smoke run: without Supabase settings, auth is off and the (app)
# screens render without a session.

# FastAPI base URL (openapi-fetch client).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project (Settings > API). The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated flags: calculators=<id>+<id>, sankey, e2e. See CLAUDE.md.
NEXT_PUBLIC_FEATURES=calculators=401k_match
