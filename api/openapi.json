            "type": "string"
          }
        },
        "required": [
          "status",
          "git_sha",
          "alembic_revision"
        ],
        "title": "Health",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "First Paycheck API",
    "version": "0.1.0"
  },
