# First Paycheck environment. Copy to .env and fill in; .env is git-ignored.
# Every API variable here maps to a field in api/app/config.py (a unit test
# keeps them in sync). Blank means unset. Never commit real values.

# ------------------------------------------------------------------ runtime

# development | test | production. production enables fail-fast checks.
APP_ENV=development
LOG_LEVEL=INFO
# Commit SHA reported by GET /health. Render sets RENDER_GIT_COMMIT, which is
# read when GIT_SHA is blank; locally the API falls back to `git rev-parse`.
GIT_SHA=

# ------------------------------------------------------------------ database
# Hosted Supabase, reached through the Supavisor pooler only (the direct host
# is IPv6-only and Render has no IPv6 egress).

# app_api role, transaction mode (port 6543). Used by the API and the worker.
DATABASE_URL=postgresql://app_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# postgres role, session mode (port 5432). Used by Alembic, the job queue's
# dequeue and the scheduler only.
DATABASE_URL_PRIVILEGED=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# A disposable local database for pytest. The suite creates the auth shim,
# test roles and a sibling <name>_migrations database. Never point it at Supabase.
TEST_DATABASE_URL=postgresql://localhost:5432/first_paycheck_test

# ------------------------------------------------------------------ Supabase Auth

# Project URL. The JWT issuer and the JWKS URL derive from it.
SUPABASE_URL=https://<project-ref>.supabase.co
# Optional override for the JWKS endpoint (default: <SUPABASE_URL>/auth/v1/.well-known/jwks.json).
SUPABASE_JWKS_URL=
# Inline JWKS JSON used instead of fetching the URL. Tests only; rejected in production.
SUPABASE_JWKS=

# ------------------------------------------------------------------ CORS

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Optional regex for extra origins, e.g. Vercel previews: ^https://first-paycheck-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=

# ------------------------------------------------------------------ Plaid (sandbox)

PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Passed in /link/token/create. Webhooks reach only the deployed API.
PLAID_WEBHOOK_URL=https://first-paycheck-api.onrender.com/sync/webhook
# Fernet key(s) encrypting Plaid access tokens at rest. Comma-separated for
# rotation (newest first). Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_TOKEN_KEY=

# ------------------------------------------------------------------ Anthropic

# Required in production (the API and worker refuse to start without it).
# Blank elsewhere means no model: rules-only categorization, manual entry.
ANTHROPIC_API_KEY=
# true makes the gateway return canned fixtures (tests, local demos). Rejected in production.
LLM_FAKE=false
# Pinned model ids per purpose.
LLM_MODEL_EXTRACT=claude-sonnet-5-5
LLM_MODEL_CATEGORIZE=claude-sonnet-5-5
LLM_MODEL_EXPLAIN=claude-sonnet-5-5
# Per-user daily LLM spend cap; the gateway refuses calls past it.
LLM_DAILY_BUDGET_CENTS=50

# ------------------------------------------------------------------ Sentry

# Error reporting for the API and the worker (app/sentry.py). Blank turns it off
# and the SDK is never loaded; set it only in Render.
SENTRY_DSN=

# ------------------------------------------------------------------ web (Next.js)
# Read by web/ only (set them in Vercel); the API ignores them.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated feature flags, e.g. calculators=401k_match,e2e
NEXT_PUBLIC_FEATURES=calculators=401k_match

# ------------------------------------------------------------------ CI secrets
# Not read by the app. Set as GitHub Actions secrets for .github/workflows/deploy.yml:
#   RENDER_DEPLOY_HOOK_API     deploy hook URL of the first-paycheck-api service
#   RENDER_DEPLOY_HOOK_WORKER  deploy hook URL of the first-paycheck-worker service
