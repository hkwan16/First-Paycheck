#!/bin/sh
# The repo's pre-commit hook (make setup points core.hooksPath here). It runs
# pre-commit through uv from the checkout being committed, so each worktree
# uses its own environment. `pre-commit install` instead writes one hook into
# the .git directory every worktree shares, pinned to the Python of whichever
# checkout ran it last, and it breaks once that worktree is removed.
exec uv run --quiet pre-commit run --hook-stage pre-commit
